# Server Configuration
PORT=8940
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_jwt_secret_random_key_here
ADMIN_PASSWORD_HASH=

# DANA Bisnis QRIS Configuration
MERCHANT_NAME="Nama Toko Anda"
# QRIS Statis DANA Bisnis (format EMVCo diawali 000201...)
QRIS_STATIC_STRING="00020101021126670014ID.DANA.WWW01189360091100223456785204549953033605802ID5913NAMA MERCHANT6007JAKARTA6105123406304ABCD"

# Invoice & Unique Code Settings
MIN_UNIQUE_CODE=1
MAX_UNIQUE_CODE=499
INVOICE_EXPIRY_MINUTES=15
